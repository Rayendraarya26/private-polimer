APP_NAME="BBKKP Polimer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=asia/jakarta
APP_URL=http://localhost:7000

HASH_VERIFY=false

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bbkkp_polimer
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ENDPOINT=https://storage.bbkkp.kemenperin.go.id
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=s3
AWS_BUCKET=dev-polimer
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

RECAPTCHA_ENABLE=true
RECAPTCHA_SITE_KEY=6Le_
RECAPTCHA_SECRET_KEY=6Le_

INTRANET_ENABLED=false
INTRANET_URL=https://api.kemenperin.go.id/intranet
INTRANET_DEBUG=false

SENTRY_ENVIRONMENT=${APP_ENV}
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

DB_URL_APPS=mysql://<USER>:<PASS>@127.0.0.1:2010/bbkkp_sso
DB_URL_PUK=mysql://<USER>:<PASS>@127.0.0.1:2010/bbkkp_training
DB_URL_SIL=mysql://<USER>:<PASS>@127.0.0.1:2010/bbkkp_sil
DB_URL_SIS=mysql://<USER>:<PASS>@127.0.0.1:2010/bbkkp_sis

TTE_BASE_URL=http://bbkkp_internal_service
TTE_API_KEY=

WHATSAPP_ENABLED=false
WHATSAPP_BASE_URL=https://cast.bbkkp.kemenperin.go.id
WHATSAPP_USERNAME=
WHATSAPP_PASSWORD=

INTEGRATION_API_KEY=secretIntegrationAPIKey
